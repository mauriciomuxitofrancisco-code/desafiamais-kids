.wa{background:#16a34a;color:white}.home{background:#173d67;color:white}.muted{font-size:13px;color:#61758a}
@media(max-width:430px){.answers{grid-template-columns:1fr}.stats .stat{padding:9px 4px}.stat b{font-size:19px}}
