function numericOptions(n){let a=new Set([n]);while(a.size<4){let v=Math.max(0,n+Math.floor(Math.random()*7)-3);a.add(v)}return [...a].sort(()=>Math.random()-.5).map(String)}
function letterOptions(ch){let pool='ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('').filter(x=>x!==ch.toLocaleUpperCase('pt'));let a=[ch.toLocaleUpperCase('pt')];while(a.length<4){let x=pool[Math.floor(Math.random()*pool.length)];if(!a.includes(x))a.push(x)}return a.sort(()=>Math.random()-.5)}
