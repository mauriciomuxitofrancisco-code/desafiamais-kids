function answer(btn,opt,correct){if(locked)return;locked=true;let buttons=[...$('answers').children];buttons.forEach(b=>{b.disabled=true;if(b.textContent===correct)b.classList.add('correct')});if(String(opt)===correct){score+=10;$('feedback').textContent='⭐ Muito bem! Resposta certa. +10 pontos';}else{$('feedback').textContent='Quase! A resposta correta é '+correct+'. Continua a aprender!';btn.classList.add('wrong')}update();save()}
