 locked=false;
 let idx;do{idx=Math.floor(Math.random()*TOTAL)}while(used.has(idx));
 used.add(idx);let wi=Math.floor(idx/4),ti=idx%4,w=WORDS[wi],t=types[ti];current={w,t};
 $('kind').textContent=t.name+' · Desafio '+(used.size);
 $('question').textContent=t.q;$('word').textContent=w.toLocaleUpperCase('pt');
